{
  "version": 1,
  "planName": "8周训练计划",
  "days": [
    {
      "id": "strength-a",
      "name": "力量A",
      "focus": "卧推主导 · 上肢推拉 + 下肢中等强度",
      "blocks": [
        {
          "exerciseId": "smith-bench",
          "name": "史密斯卧推",
          "primaryMuscles": ["胸大肌整体", "中胸"],
          "secondaryMuscles": ["肱三头肌", "三角肌前束"],
          "notes": "7.5kg是主工作重量；如果第2组低于6次，后两组继续5kg",
          "progressionHint": "顶组达到8次后可考虑小幅加重",
          "sets": [
            { "kind": "top", "plannedWeight": "7.5", "targetReps": "6-8", "restSeconds": 180 },
            { "kind": "backoff", "plannedWeight": "7.5", "targetReps": "6-8", "restSeconds": 180 },
            { "kind": "backoff", "plannedWeight": "5", "targetReps": "8-10", "restSeconds": 180 },
            { "kind": "backoff", "plannedWeight": "5", "targetReps": "8-10", "restSeconds": 180 }
          ]
        },
        {
          "exerciseId": "seated-row",
          "name": "坐姿划船",
          "primaryMuscles": ["中背", "菱形肌", "斜方肌中下束"],
          "secondaryMuscles": ["背阔肌", "肱二头肌", "后三角"],
          "notes": "先把3组都稳定做到10次以上，再考虑加重。控制肩胛，不耸肩",
          "sets": [
            { "kind": "working", "plannedWeight": "32", "targetReps": "8-12", "restSeconds": 120 },
            { "kind": "working", "plannedWeight": "32", "targetReps": "8-12", "restSeconds": 120 },
            { "kind": "working", "plannedWeight": "32", "targetReps": "8-12", "restSeconds": 120 }
