          "name": "哈克深蹲",
          "primaryMuscles": ["股四头肌"],
          "secondaryMuscles": ["臀大肌", "内收肌"],
          "notes": "A日只做中等强度，不追求上12.5kg",
          "sets": [
            { "kind": "working", "plannedWeight": "10", "targetReps": "8-10", "restSeconds": 150 },
            { "kind": "working", "plannedWeight": "10", "targetReps": "8-10", "restSeconds": 150 },
            { "kind": "working", "plannedWeight": "10", "targetReps": "8-10", "restSeconds": 150 }
